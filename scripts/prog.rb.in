# Generated by .github/workflows/release.yml from scripts/prog.rb.in — do not edit by hand.
class Prog < Formula
  desc "Manage git repositories by path rules"
  homepage "https://github.com/bytemain/prog"
  version "@VERSION@"

  on_macos do
    on_arm do
      url "https://github.com/bytemain/prog/releases/download/v#{version}/prog-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_MAC_ARM@"
    end
    on_intel do
      url "https://github.com/bytemain/prog/releases/download/v#{version}/prog-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_MAC_X64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/bytemain/prog/releases/download/v#{version}/prog-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_LINUX_ARM@"
    end
    on_intel do
      url "https://github.com/bytemain/prog/releases/download/v#{version}/prog-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_LINUX_X64@"
    end
  end

  def install
    bin.install "prog"
  end

  def caveats
    <<~EOS
      Add the shell integration to your shell config, e.g. ~/.zshrc:
        eval "$(prog shell zsh)"
    EOS
  end

  test do
    system bin/"prog", "--version"
  end
end
